{
  "name": "kairos-command",
  "version": "1.0.3",
  "description": "Terminal client and CLI for Kairos",
  "type": "module",
  "bin": {
    "kairos": "dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "nodemon --exec bun src/index.ts",
    "build": "bun build ./CLI/src/index.tsx --target=node --outfile=dist/index.js",
    "prepublishOnly": "bun run build",
    "kairos": "bun run CLI/src/index.tsx",
    "client": "bun --cwd client run dev"
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.1",
    "@prisma/client": "6.19.0",
    "@types/bcrypt": "^6.0.0",
    "@types/bun": "latest",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/ws": "^8.18.1",
    "bcrypt": "^6.0.0",
    "better-auth": "^1.7.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "figlet": "^1.11.4",
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemon": "^3.1.14",
    "prisma": "6.19.0",
    "react": "^19.3.0",
    "typescript": "^7.0.2",
    "ws": "^8.21.3"
  }
}
